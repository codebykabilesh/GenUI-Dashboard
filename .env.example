# Application
APP_NAME=GenUI MCP Runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM provider: mock (no key) | openrouter | openai_compatible (any /chat/completions API with tool calling)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Defaults to https://openrouter.ai/api/v1 for openrouter; required for openai_compatible
LLM_BASE_URL=
LLM_TIMEOUT=60
# openrouter also falls back to these legacy names:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Max LLM->tool rounds per chat request
MAX_TOOL_ROUNDS=8

# MCP servers: JSON list, or a path to a JSON file (takes precedence if set).
# Empty = app starts with no servers.
# HTTP:  [{"name":"investigation","url":"http://127.0.0.1:8101/mcp"}]
# stdio: [{"name":"local","command":"python","args":["server.py"]}]
MCP_SERVERS=[{"name":"investigation","url":"http://127.0.0.1:8101/mcp"},{"name":"prefab","url":"http://127.0.0.1:8102/mcp"}]
MCP_SERVERS_FILE=
MCP_CONNECT_TIMEOUT=10
MCP_CALL_TIMEOUT=30
