# Application
APP_NAME=GenUI MCP Runtime
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Any local port is also allowed by default; set to empty to disable
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|\[::1\]):\d+$

# LLM provider: mock (no key) | groq | openrouter | openai_compatible (any /chat/completions API with tool calling)
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_KEY=
# Defaults to https://openrouter.ai/api/v1 for openrouter; required for openai_compatible
LLM_BASE_URL=
LLM_TIMEOUT=60
# groq / openrouter also fall back to these names:
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Max LLM->tool rounds per chat request
MAX_TOOL_ROUNDS=5
# GenUI: let the LLM design each panel's layout (falls back to the built-in template if its
# layout is invalid or slow). Ignored with LLM_PROVIDER=mock.
GENUI_LLM_LAYOUT=true
GENUI_LAYOUT_TIMEOUT=25

# MCP servers: JSON list, or a path to a JSON file (takes precedence if set).
# Empty = app starts with no servers.
# HTTP:  [{"name":"investigation","url":"http://127.0.0.1:8101/mcp"},{"name":"analytics","url":"http://127.0.0.1:8102/mcp"}]
# stdio: [{"name":"local","command":"python","args":["server.py"]}]
MCP_SERVERS=[]
MCP_SERVERS_FILE=
MCP_CONNECT_TIMEOUT=10
MCP_CALL_TIMEOUT=30
